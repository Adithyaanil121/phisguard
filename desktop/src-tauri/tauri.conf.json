{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/dev/tooling/cli/schema.json",
  "build": {
    "beforeDevCommand": "",
    "beforeBuildCommand": "",
    "devPath": "../ui",
    "distDir": "../ui"
  },
  "package": {
    "productName": "PhishGuard Desktop",
    "version": "1.0.0"
  },
  "tauri": {
    "allowlist": {
      "all": false,
      "http": {
        "all": true,
        "request": true,
        "scope": ["http://127.0.0.1:8000/*", "http://localhost:8000/*"]
      },
      "notification": {
        "all": true
      },
      "shell": {
        "all": false,
        "open": true
      }
    },
    "bundle": {
      "active": true,
      "identifier": "com.phishguard.desktop",
      "targets": "all"
    },
    "security": {
      "csp": "default-src 'self'; connect-src http://127.0.0.1:8000"
    },
    "windows": [
      {
        "title": "PhishGuard Desktop Security Shield",
        "width": 480,
        "height": 620,
        "resizable": false,
        "fullscreen": false
      }
    ]
  }
}
